---
// "The dark side of the mood" — dark disco hall. Pure scenery: the artifact page slots
// its hero + caption in. Emoji are placeholders for the client's artwork; layers carry
// data-depth for horizontal parallax.
---

<div class="world world--disco">
  <div class="world__layer bg" data-depth="1"></div>
  <slot />
  <span class="world__focal ball" data-depth="0.45" aria-hidden="true">🪩</span>
  <span class="world__focal animal" data-depth="0.85" aria-hidden="true">🦫</span>
</div>

<style>
  .world--disco {
    color: #eef1ff;
  }
  .world--disco .bg {
    background: var(--disco-bg);
  }
  .world--disco .ball {
    left: 95vw;
    top: 18%;
    filter: drop-shadow(0 0 40px rgba(180, 200, 255, 0.5));
  }
  .world--disco .animal {
    left: 175vw;
    bottom: 8%;
    top: auto;
  }
</style>
