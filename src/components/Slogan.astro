---
// The wordmark's caption: an all-uppercase Futura block justified to the DECOROSA logo's
// own lateral boundaries (both use --logo-w). Each ROW carries one colour of the wordmark's
// palette (black excluded), the lead is broken into four rows of deliberately uneven
// length — each scaled to fill the width, so each ends up at its own size — and the items
// sit together on one row below it, separated by ' | '. Every size is a share of the block
// width fixed by a character budget rather than by the words a row holds, so the block is
// exactly as tall (and never wraps) in every locale.
interface Props {
  lead: string;
  items: string[];
}
const { lead, items } = Astro.props;
// Wordmark colours minus black, one per row from top to bottom: the four lead rows, then
// the items row — separators included — entirely in red.
const ROW_COLORS = ['--c-green', '--c-orange', '--c-purple', '--c-yellow'];
const ITEMS_COLOR = '--c-red';
// Relative length of each lead row. Uneven on purpose: a row's size is derived from the
// share of the budget it gets, so uneven rows are what makes the four sizes differ.
const ROW_WEIGHTS = [1.08, 0.93, 1.12, 0.9];
// Character budget for the whole lead, split between the rows by weight. Row sizes come
// from these shares, NOT from the words a row ends up holding — so the block is exactly
// as tall in every locale, and a shorter sentence simply sits a little looser. Sized for
// the longest lead we carry; up to ~10% over budget still fits on the headroom below.
const LEAD_BUDGET = 96;
// Average advance per character of uppercase Futura/Jost, measured at 0.04em tracking
// (~0.6em) with headroom, so a row is always a little narrower than the box and justify
// only has to spread the gaps — never wide enough to wrap. Raising it past the measured
// value is also what holds the block a touch below its full width.
const EM_PER_CHAR = 0.7;
// Same measurement for the items row, whose wider 0.08em tracking costs a little more
// per character, and its own budget (the four items plus their three separators).
const ITEMS_EM_PER_CHAR = 0.68;
const ITEMS_BUDGET = 54;

const WEIGHT_SUM = ROW_WEIGHTS.reduce((a, b) => a + b, 0);
const rowBudgets = ROW_WEIGHTS.map((w) => (LEAD_BUDGET * w) / WEIGHT_SUM);
// Font size that makes `chars` characters span the whole logo width.
const sizeFor = (chars: number, emPerChar: number) => `${(100 / (chars * emPerChar)).toFixed(2)}cqw`;

// Break the lead into four rows, choosing the breaks that keep every row closest to its
// own budget (a greedy fill would undershoot the early rows and dump the remainder on the
// last one, which — since the sizes are fixed — is the one row that must not overflow).
const words = lead.split(' ');
const lengthOf = (from: number, to: number) => words.slice(from, to).join(' ').length;
const memo = new Map<string, { cost: number; breaks: number[] } | null>();
const bestBreaks = (from: number, row: number): { cost: number; breaks: number[] } | null => {
  if (row === rowBudgets.length) return from === words.length ? { cost: 0, breaks: [] } : null;
  const key = `${from}:${row}`;
  if (memo.has(key)) return memo.get(key)!;
  let best: { cost: number; breaks: number[] } | null = null;
  // Leave at least one word for each of the rows still to come.
  for (let to = from + 1; to <= words.length - (rowBudgets.length - row - 1); to++) {
    const rest = bestBreaks(to, row + 1);
    if (!rest) continue;
    const cost = (lengthOf(from, to) / rowBudgets[row] - 1) ** 2 + rest.cost;
    if (!best || cost < best.cost) best = { cost, breaks: [to, ...rest.breaks] };
  }
  memo.set(key, best);
  return best;
};
const rows: string[][] = [];
let cut = 0;
for (const to of bestBreaks(0, 0)?.breaks ?? [words.length]) {
  rows.push(words.slice(cut, to));
  cut = to;
}
---

<div class="slogan">
  <p class="slogan__lead">
    {
      rows.map((row, i) => (
        <span
          class="slogan__row"
          style={`font-size:${sizeFor(rowBudgets[i], EM_PER_CHAR)};color:var(${ROW_COLORS[i % ROW_COLORS.length]})`}
        >
          {row.join(' ')}
        </span>
      ))
    }
  </p>
  <p
    class="slogan__items"
    style={`font-size:${sizeFor(ITEMS_BUDGET, ITEMS_EM_PER_CHAR)};color:var(${ITEMS_COLOR})`}
  >
    {
      items.map((item, i) => (
        <>
          {item}
          {i < items.length - 1 && <>{' '}<span aria-hidden="true">|</span>{' '}</>}
        </>
      ))
    }
  </p>
</div>

<style>
  .slogan {
    /* Slightly inside the wordmark's own edges, and the container the type is measured
       against — every size below is a share of this width. */
    width: calc(var(--logo-w) * 0.96);
    container-type: inline-size;
    margin-inline: auto;
    display: grid;
    gap: var(--space-s);
    font-family: var(--font-futura);
    text-transform: uppercase;
    /* Both edges flush on every line, last one included. */
    text-align: justify;
    text-align-last: justify;
  }
  .slogan__lead {
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  /* One row of the lead: its own size (set inline), its own justified line. */
  .slogan__row {
    display: block;
    line-height: 1.15;
  }
  /* Its inline size keeps it on ONE row at the logo's width — justification then spreads
     the four items and their separators across it. */
  .slogan__items {
    margin: 0;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
  }
</style>
