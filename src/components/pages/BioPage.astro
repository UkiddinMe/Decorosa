---
// "I AM" — the artist's life as a horizontally scrolled ruler. Shared by both locales.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../BackLink.astro';
import { bioEvents } from '../../data/bio';
import { withBase } from '../../data/routes';
import { t } from '../../data/i18n';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const dict = t(lang);

// Every event is laid out from a seeded RNG, so the irregularity (slot width, card size,
// tick jitter) is stable between server render and client (no hydration flicker) and
// stable between builds.
const TICKS_PER_SLOT = 9; // at slot scale 1; the count follows the slot so density stays even
function mulberry32(seed: number): () => number {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** What a media entry is: the panel plays these, and a card cannot wear one as its face. */
const isVideo = (src: string): boolean => /\.(mp4|webm)$/.test(src);

const layout = bioEvents.map((_, index) => {
  const rand = mulberry32(index * 7919 + 13);
  // years land at uneven distances from one another
  const slot = 0.72 + rand() * 0.75;
  // odd tick count keeps the event's own tick dead centre of its slot
  const count = Math.max(5, Math.round(TICKS_PER_SLOT * slot) | 1);
  const middle = (count - 1) / 2;
  const ticks = Array.from({ length: count }, (_, i) => {
    const isEvent = i === middle;
    const major = i % 3 === 0;
    return {
      isEvent,
      left: ((i + 0.5) / count) * 100 + (isEvent ? 0 : (rand() - 0.5) * 2.5),
      // the event tick's own height comes from --event-tick in CSS
      height: (major ? 46 : 20) + rand() * 14,
      width: isEvent ? 10 : 5 + rand() * 3,
      tilt: (rand() - 0.5) * 7,
      fade: isEvent ? 1 : 0.55 + rand() * 0.35,
    };
  });
  return {
    slot,
    ticks,
    card: { width: 0.86 + rand() * 0.45, ratio: 0.88 + rand() * 0.32 },
  };
});
---

<BaseLayout lang={lang} title={`${dict.bio.heading} — DECOROSA`}>
  <BackLink href={lang === 'it' ? '/showcase' : '/en/showcase'} label={dict.nav.back} />

  <main class="bio">
    <!-- Spray-can edge for the ruler strokes: a slow displacement bends them off-straight
         (hand-drawn), the blur is the overspray, the fast displacement the paint dust. -->
    <svg class="bio__defs" aria-hidden="true" focusable="false">
      <filter id="spray" x="-30%" y="-20%" width="160%" height="140%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.007 0.016" numOctaves="3" seed="9" result="wobble" />
        <feDisplacementMap in="SourceGraphic" in2="wobble" scale="8" xChannelSelector="R" yChannelSelector="G" result="drawn" />
        <feGaussianBlur in="drawn" stdDeviation="1" result="soft" />
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" seed="3" result="grain" />
        <feDisplacementMap in="soft" in2="grain" scale="3" xChannelSelector="R" yChannelSelector="G" result="dusty" />
        <!-- the blur costs the stroke its body; win it back without hardening the edge -->
        <feComponentTransfer in="dusty">
          <feFuncA type="linear" slope="1.7" intercept="-0.08" />
        </feComponentTransfer>
      </filter>
    </svg>

    <div class="bio__viewport" data-bio tabindex="0" aria-label={dict.bio.heading}>
      <ol
        class="bio__track"
        style={`--first-slot:${layout[0].slot};--last-slot:${layout[layout.length - 1].slot}`}
      >
        {
          bioEvents.map((event, index) => {
            const txt = event.i18n[lang];
            const { slot, ticks, card } = layout[index];
            const first = event.media?.[0];
            // a card whose first item is a video has no face to show: it keeps its tint
            const cover = first && !isVideo(first.src) ? first : undefined;
            // an event with artwork opens its panel, a tint-only one is just a caption
            const Card = event.media ? 'button' : 'div';
            const cardProps = event.media
              ? ({ type: 'button', 'data-bio-open': event.id } as const)
              : ({ tabindex: '0' } as const);
            return (
              <li
                class="bio-event"
                data-bio-event
                style={`--tint:${event.tint};--slot-scale:${slot};--card-w:${card.width};--card-ar:${card.ratio}`}
              >
                <div class="bio-event__stack">
                  <Card
                    class="bio-event__card"
                    data-pages={event.media && event.media.length > 1 ? '' : undefined}
                    data-play={first && isVideo(first.src) ? '' : undefined}
                    {...cardProps}
                  >
                    {cover ? (
                      <img
                        class="bio-event__photo"
                        src={withBase(cover.src)}
                        width={cover.w}
                        height={cover.h}
                        alt={txt.title}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="bio-event__photo" />
                    )}
                    <span class="bio-event__desc">
                      <strong>{txt.title}</strong>
                      {txt.description && <span>{txt.description}</span>}
                    </span>
                  </Card>
                  <span class="bio-event__year">{txt.year ?? event.year}</span>
                </div>
                <div class="bio-event__ruler" aria-hidden="true">
                  {ticks.map((tick) => (
                    <span
                      class="tick"
                      data-event={tick.isEvent ? '' : undefined}
                      style={`--left:${tick.left}%;--h:${tick.height}px;--w:${tick.width}px;--tilt:${tick.tilt}deg;--fade:${tick.fade}`}
                    />
                  ))}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>

    <p class="bio__hint" aria-hidden="true">{dict.bio.hint} →</p>

    <!-- One dialog per event that has artwork, outside the scroller (so the timeline's
         wheel-to-horizontal never fires under an open lightbox). A card is far too small
         to read a comic page in; this is where the pages are actually looked at. -->
    {
      bioEvents
        .filter((event) => event.media)
        .map((event) => {
          const txt = event.i18n[lang];
          return (
            <dialog class="bio-zoom" data-bio-zoom={event.id} aria-label={txt.title}>
              <button class="bio-zoom__close" type="button" data-bio-close>
                {dict.nav.close}
              </button>
              <div class="bio-zoom__pages" data-bio-pages>
                {event.media!.map((item) =>
                  isVideo(item.src) ? (
                    <video
                      src={withBase(item.src)}
                      width={item.w}
                      height={item.h}
                      controls
                      playsinline
                      preload="metadata"
                    />
                  ) : (
                    <img
                      src={withBase(item.src)}
                      width={item.w}
                      height={item.h}
                      alt={txt.title}
                      loading="lazy"
                      decoding="async"
                    />
                  )
                )}
              </div>
              <p class="bio-zoom__caption">
                <strong>{txt.year ?? event.year}</strong> {txt.title}
              </p>
            </dialog>
          );
        })
    }
  </main>

  <script>
    import '../../scripts/bio.ts';
  </script>
</BaseLayout>

<style>
  /* ruler band / hint band */
  .bio {
    height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-rows: 1fr auto;
  }
  /* filter definition only — never painted */
  .bio__defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  .bio__hint {
    margin: 0;
    padding: 0 var(--space-m) var(--space-m);
    justify-self: end;
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--c-grey);
  }

  /* The scroller, filling the middle band; the ruler runs off both edges. */
  .bio__viewport {
    min-height: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }
  .bio__viewport::-webkit-scrollbar {
    display: none;
  }
  .bio__track {
    --slot: clamp(300px, 30vw, 480px);
    display: flex;
    height: 100%;
    /* Lead-in is half of what would centre the first event: the timeline opens left of
       centre so the next events peek in from the right and read as "scroll this way".
       Lead-out still centres the last event, so the scroll ends on it. */
    padding-left: calc(25vw - var(--slot) * var(--first-slot) / 4);
    padding-right: calc(50vw - var(--slot) * var(--last-slot) / 2);
    width: max-content;
  }

  /* One event = one slot of the ruler, its own tick dead centre; --slot-scale spaces the
     years unevenly. */
  .bio-event {
    position: relative;
    flex: 0 0 calc(var(--slot) * var(--slot-scale, 1));
    height: 100%;
    --baseline: 22%;
    /* the event's own tick is taller than the ruler's; the photo/year stack clears it */
    --event-tick: 66px;
  }
  /* the open label overhangs its neighbours, so lift the whole slot while it shows */
  .bio-event:has(.bio-event__card:hover),
  .bio-event:has(.bio-event__card:focus-visible),
  .bio-event[data-active] {
    z-index: 2;
  }
  /* The whole group is sprayed at once, so neighbouring strokes bend together. The box
     stands on the baseline and is tall enough to hold the longest stroke. */
  .bio-event__ruler {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--baseline);
    height: calc(var(--event-tick) + 20px);
    filter: url(#spray);
  }
  /* Spray line: a rounded, slightly tilted stroke standing on the baseline, thinning as
     it lifts off — the filter does the wobble and the dusty edge. */
  .tick {
    position: absolute;
    left: var(--left);
    bottom: 0;
    width: var(--w);
    height: var(--h);
    margin-left: calc(var(--w) / -2);
    background: var(--c-black);
    border-radius: var(--w);
    opacity: var(--fade);
    rotate: var(--tilt);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, #000 60%, rgb(0 0 0 / 0.72));
  }
  .tick[data-event] {
    height: var(--event-tick);
    background: var(--tint);
  }

  /* Photo + year, stacked above the event's own tick. */
  .bio-event__stack {
    position: absolute;
    left: 50%;
    bottom: var(--baseline);
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    padding-bottom: calc(var(--event-tick) + 0.5rem);
  }
  .bio-event__year {
    font-family: var(--font-futura);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .bio-event__card {
    position: relative;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
    /* height-aware so the photo, its year and the tick always fit the band; --card-w and
       --card-ar (near-square, both sides of 1) make no two cards the same size */
    width: calc(clamp(110px, min(13vw, 21svh), 200px) * var(--card-w, 1));
    /* --near is written by bio.ts (1 at viewport centre), --hover by the rules below:
       the photo swells as it reaches the middle, and a little more under the pointer. */
    scale: calc(1 + 0.09 * var(--near, 0) + 0.1 * var(--hover, 0));
    transform-origin: 50% 100%;
    transition: scale 0.35s var(--ease-out);
  }
  /* The label shows under the pointer on a mouse; on touch there is no hover (and a tap
     would stick it on), so there bio.ts marks the event at the centre `data-active`. */
  @media (hover: hover) {
    .bio-event__card:hover {
      --hover: 1;
    }
  }
  .bio-event__card:focus-visible,
  .bio-event[data-active] .bio-event__card {
    --hover: 1;
  }
  button.bio-event__card {
    cursor: zoom-in;
  }
  /* A multi-page event (the comic) is a pile: two tinted plates peeking out from under
     the top page, fanned a little further apart on hover. */
  .bio-event__card[data-pages]::before,
  .bio-event__card[data-pages]::after {
    content: '';
    position: absolute;
    inset: 0;
    /* behind the top page — the card's own `scale` makes it a stacking context, so the
       plates cannot slip behind the timeline itself */
    z-index: -1;
    border-radius: 0.4rem;
    background: var(--tint);
    box-shadow: 0 10px 22px rgb(0 0 0 / 0.14);
    rotate: calc(var(--fan) * (1deg + 1.4deg * var(--hover, 0)));
    translate: calc(var(--fan) * 3%) 0;
    transition:
      rotate 0.3s var(--ease-out),
      translate 0.3s var(--ease-out);
  }
  .bio-event__card[data-pages]::before {
    --fan: -1;
  }
  .bio-event__card[data-pages]::after {
    --fan: 2;
  }
  /* A video event has no still to show, so the card says what it holds: a play mark on
     its tint, swelling with the card under the pointer. */
  .bio-event__card[data-play]::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -30% -50%;
    border-style: solid;
    border-width: 0.85rem 0 0.85rem 1.4rem;
    border-color: transparent transparent transparent var(--c-white);
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.35));
    pointer-events: none;
  }
  .bio-event__photo {
    display: block;
    position: relative;
    width: 100%;
    /* the <img> carries width/height attributes, and that presentational height would
       beat the aspect ratio below — the card's own box must win */
    height: auto;
    aspect-ratio: var(--card-ar, 1);
    object-fit: cover;
    border-radius: 0.4rem;
    background: var(--tint);
    box-shadow: 0 14px 34px rgb(0 0 0 / 0.18);
  }
  /* The photo is always on show; the label is a tab tucked behind it that slides out of
     its right edge (the scroll direction), bottom-aligned with it, a tint stripe on the
     edge it shares with the photo. */
  .bio-event__desc {
    position: absolute;
    left: calc(100% - 0.4rem);
    bottom: 0.6rem;
    /* behind the photo and the comic's plates (-1), in the card's stacking context */
    z-index: -2;
    width: 14rem;
    border-radius: 0 0.4rem 0.4rem 0;
    border-left: 0.4rem solid var(--tint);
    padding: 0.7rem 0.8rem 0.7rem 1rem;
    display: grid;
    gap: 0.35em;
    background: var(--c-black);
    color: var(--c-white);
    font-size: clamp(0.62rem, 0.75vw, 0.8rem);
    line-height: 1.35;
    box-shadow: 0 14px 34px rgb(0 0 0 / 0.18);
    /* it overhangs the card, so it must never steal the hover from its own photo */
    pointer-events: none;
    opacity: var(--hover, 0);
    translate: calc(-70% * (1 - var(--hover, 0))) 0;
    transition:
      opacity 0.3s var(--ease-out),
      translate 0.35s var(--ease-out);
  }
  /* A phone has no room beside the card: the label rises above it instead (the year and
     the ruler are below). */
  @media (max-width: 40rem) {
    .bio-event__desc {
      left: 50%;
      bottom: calc(100% + 0.6rem);
      width: min(16rem, 80vw);
      border-radius: 0.4rem;
      border-left: 0;
      border-bottom: 0.4rem solid var(--tint);
      padding: 0.7rem 0.8rem;
      font-size: 0.8rem;
      translate: -50% calc(1rem * (1 - var(--hover, 0)));
    }
  }
  .bio-event__desc strong {
    font-family: var(--font-futura);
    font-size: 1.15em;
    letter-spacing: 0.02em;
  }

  /* Lightbox: a panel standing in front of the page and taking nearly all of it, because
     a comic page has to be *read*. Three rows — close, artwork, caption — and the artwork
     row gets everything left over. */
  .bio-zoom {
    margin: auto;
    width: 96vw;
    max-width: none;
    height: 94svh;
    max-height: none;
    padding: var(--space-s);
    border: 0;
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  /* The layout belongs to the open state only: a plain `display: grid` on the dialog
     would beat the UA's `dialog:not([open]) { display: none }` and leave both panels
     sitting on the page. */
  .bio-zoom[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-s);
  }
  .bio-zoom::backdrop {
    background: rgb(20 20 20 / 0.82);
  }
  /* The pages run sideways, like every other row on this site: each one whole and as tall
     as the panel allows, the set scrolling horizontally when it is wider than the panel
     (`safe center` so centring never pushes the first page out of reach). */
  .bio-zoom__pages {
    display: flex;
    align-items: center;
    justify-content: safe center;
    gap: var(--space-s);
    min-height: 0;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }
  .bio-zoom__pages img,
  .bio-zoom__pages video {
    flex: 0 0 auto;
    display: block;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: 0.3rem;
    scroll-snap-align: center;
  }
  .bio-zoom__caption {
    margin: 0;
    font-size: var(--step--1);
    color: var(--c-grey);
  }
  .bio-zoom__caption strong {
    font-family: var(--font-futura);
    color: var(--fg);
    letter-spacing: 0.06em;
  }
  .bio-zoom__close {
    justify-self: end;
    padding: 0.3rem 0.8rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--step--1);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-event__card {
      scale: 1;
    }
  }
</style>
