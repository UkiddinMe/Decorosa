---
// "MY" — the artifacts as a finite lateral run, closed by two cards that leave the
// section (the tiles page, and back up to the showcase). Shared by both locales.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtifactCard from '../works/ArtifactCard.astro';
import EndCard from '../works/EndCard.astro';
import DuneScene from '../works/DuneScene.astro';
import { artifacts } from '../../data/artifacts';
import { t } from '../../data/i18n';
import { withBase } from '../../data/routes';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const dict = t(lang);
const isIt = lang === 'it';
---

<BaseLayout lang={lang} title={`${dict.works.heading} — DECOROSA`}>
  <main class="works">
    <div class="works__viewport" data-works tabindex="0" aria-label={dict.works.heading}>
      <div class="works__track">
        {artifacts.map((a) => <ArtifactCard artifact={a} lang={lang} />)}
        <EndCard href={isIt ? '/mosaico' : '/en/mosaic'} title={dict.works.tiles}>
          <DuneScene />
        </EndCard>
        <EndCard
          href={isIt ? '/showcase' : '/en/showcase'}
          title={dict.works.backToShowcase}
          media={`url("${withBase('/assets/works/back-to-showcase.webp')}") center / cover`}
        />
      </div>
    </div>

    <p class="works__hint" aria-hidden="true">← {dict.works.hint} →</p>
  </main>

  <script>
    import '../../scripts/works.ts';
  </script>
</BaseLayout>

<style>
  /* The run centres on the screen itself — the hint floats over the bottom corner
     rather than taking a band, which would push the cards above the true centre. */
  .works {
    position: relative;
    height: 100svh;
    overflow: hidden;
    display: grid;
    align-content: center;
    /* height-aware: a 2:3 card must leave room for its title *and* its centre swell */
    --artifact-w: clamp(170px, min(19vw, 34svh), 340px);
  }
  .works__hint {
    position: absolute;
    right: var(--space-m);
    bottom: var(--space-m);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--c-grey);
  }
  .works__viewport {
    align-self: center;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    /* room for the centre card's swell */
    padding-block: 6svh;
  }
  .works__viewport::-webkit-scrollbar {
    display: none;
  }
  /* Half a viewport of runway at each end: the run is finite now, so the first and the
     last card must still be able to reach the centre, where the swell is. */
  .works__track {
    --gap: clamp(4.5rem, 11vw, 13rem);
    display: flex;
    width: max-content;
    /* start, not center: a two-line title must not push its card up relative to the
       others — every card hangs from the same top edge */
    align-items: start;
    gap: var(--gap);
    padding-inline: calc(50vw - var(--artifact-w) / 2);
  }
</style>
