---
// Shared showcase page for both locales — the thin files in src/pages/ only pick `lang`.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../BackLink.astro';
import Scene from '../showcase/Scene.astro';
import { t } from '../../data/i18n';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const dict = t(lang);
---

<BaseLayout lang={lang} title="Showcase — DECOROSA">
  <BackLink href={lang === 'it' ? '/' : '/en'} label={dict.nav.back} />
  <Scene lang={lang} />
  <script>
    import '../../scripts/showcase.ts';
  </script>
</BaseLayout>
