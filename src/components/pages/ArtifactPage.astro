---
// Detail page of one artifact, developing to the right (downwards on portrait screens —
// the `(orientation: portrait)` blocks here and in stories/worlds) and entered by the card flying in
// from the "MY" run (view-transition-name: artifact-hero). An artifact with a story
// component (stories/*) is told by it; the others still get a parallax world with their
// hero + caption. Either way the page ends on the next artifact (NextWork).
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../BackLink.astro';
import ArtifactPiece from '../works/ArtifactPiece.astro';
import DiscoWorld from '../worlds/DiscoWorld.astro';
import JungleWorld from '../worlds/JungleWorld.astro';
import DesertWorld from '../worlds/DesertWorld.astro';
import TigreStory from '../stories/TigreStory.astro';
import NextWork from '../works/NextWork.astro';
import type { Artifact } from '../../data/artifacts';
import { t } from '../../data/i18n';

interface Props {
  artifact: Artifact;
  lang: 'it' | 'en';
}
const { artifact, lang } = Astro.props;
const dict = t(lang);
const txt = artifact.i18n[lang];
const worlds = { disco: DiscoWorld, jungle: JungleWorld, desert: DesertWorld } as const;
const World = worlds[artifact.world];
const stories: Partial<Record<string, typeof TigreStory>> = { 'credenza-jungle': TigreStory };
const Story = stories[artifact.id];
const tone = Story || artifact.world === 'desert' ? 'light' : 'dark';
---

<BaseLayout lang={lang} title={`${txt.title} — DECOROSA`}>
  <BackLink
    href={lang === 'it' ? '/opere' : '/en/works'}
    label={dict.nav.backToWorks}
    tone={tone}
  />

  <main class="artifact">
    <div class="artifact__viewport" data-artifact tabindex="0" aria-label={txt.title}>
      <div class="artifact__track">
        {
          Story ? (
            <Story artifact={artifact} lang={lang} />
          ) : (
            <World>
              <div class="artifact__intro">
                <div class="artifact__hero" data-page-hero>
                  {artifact.image && <ArtifactPiece artifact={{ ...artifact, image: artifact.image }} />}
                </div>
                <div class="world__caption">
                  <h1>{txt.title}</h1>
                  {txt.subtitle && <span class="sub">{txt.subtitle}</span>}
                  <p>{txt.body}</p>
                </div>
              </div>
            </World>
          )
        }
        <NextWork artifact={artifact} lang={lang} />
      </div>
    </div>
    <span class="artifact__progress" data-progress aria-hidden="true"></span>
  </main>

  <script>
    import '../../scripts/artifact.ts';
  </script>
</BaseLayout>

<style is:global>
  /* The hero is slotted into the world component, so it can't be scoped-styled here. */
  .artifact__intro {
    position: absolute;
    left: 6vw;
    top: 50%;
    translate: 0 -50%;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  /* The piece itself, frameless, in the card's 2:3 box. */
  .artifact__hero {
    flex: 0 0 auto;
    width: clamp(180px, 17vw, 290px);
    aspect-ratio: 2 / 3;
    display: flex;
    /* the run's card stamps the same name on itself on click, so it morphs into this */
    view-transition-name: artifact-hero;
  }
  .artifact__hero > .piece {
    filter: drop-shadow(0 16px 22px rgb(0 0 0 / 0.35));
  }
  .artifact__intro .world__caption {
    position: static;
    translate: none;
  }
  @media (orientation: portrait) {
    .artifact__intro {
      left: 0;
      right: 0;
      top: 14svh;
      translate: none;
      flex-direction: column;
      padding: 0 var(--space-m);
      text-align: center;
    }
    .artifact__hero {
      width: min(58vw, 40svh);
    }
  }
</style>

<style>
  .artifact {
    height: 100svh;
    overflow: hidden;
    background: var(--c-black);
  }
  .artifact__viewport {
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }
  .artifact__viewport::-webkit-scrollbar {
    display: none;
  }
  .artifact__track {
    display: flex;
    width: max-content;
    height: 100%;
  }
  .artifact__track > :global(.world) {
    flex: 0 0 auto;
  }
  @media (orientation: portrait) {
    .artifact__viewport {
      overflow-x: hidden;
      overflow-y: auto;
    }
    .artifact__track {
      flex-direction: column;
      width: 100%;
      height: auto;
    }
  }
  /* how far along the page is: --progress (0..1) is written by artifact.ts */
  .artifact__progress {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    height: 3px;
    background: var(--c-orange);
    transform-origin: 0 50%;
    scale: var(--progress, 0) 1;
  }
</style>
