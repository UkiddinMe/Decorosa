---
// L'anno del drago di legno's detail page, told — like every story — as a sideways run of
// full-height slices (a column on portrait screens, the block at the end). Its idea is the
// moodboard: the street outside an Italian Chinese restaurant at night. Deliberately a
// kitsch of the Italian high street, not an imitation of anything Chinese — so no mock-
// oriental lettering and no made-up characters: the type is the site's own, and the
// lanterns are painted with the piece's eye and scales. The page walks past that frontage:
// red-lit boards under an eave (DragoEave: blue LED rope, swinging paper lanterns), the
// photos as lit shop windows with a frosted band and a transom, the title in neon under a
// night awning, a frosted window, a laminated menu, the details served on a
// lazy Susan that turns with the scroll, the old brown cabinet wiped into the painted one,
// a pinned walk backwards from the piece out into the room. And the piece, being a mouth
// with eyes, is the head of a dragon: its scaled body snakes behind everything for the
// whole length of the page (scripts/drago.ts). It closes on the moodboard itself, the real
// street after the made-up one. Moves: ANIMATIONS.md.
// Assets: scripts/build-story-assets.py drago -> public/assets/stories/drago/.
import ArtifactPiece from '../works/ArtifactPiece.astro';
import DragoEave from './DragoEave.astro';
import { withBase } from '../../data/routes';
import { sized } from '../../data/images';
import type { Artifact } from '../../data/artifacts';

interface Props {
  artifact: Artifact;
  lang: 'it' | 'en';
}
const { artifact, lang } = Astro.props;
const txt = artifact.i18n[lang];
const [first, second] = txt.chapters ?? [];
const src = (name: string): string => withBase(`/assets/stories/drago/${name}`);
const alt = txt.title;
const photo = (name: string, w: number, h: number) => sized(`/assets/stories/drago/${name}.webp`, w, h);
const plateAt = (name: string) => photo(`plate-${name}`, 640, 640);
// the arched heading's size: as big as fits along the arc
const archSize = (title: string): number => Math.min(34, 560 / title.length);
const ring = ['eye', 'fang', 'handle', 'scales', 'teeth', 'foot'];
---

<div class="drago" data-drago>
  <canvas class="body" data-dragon aria-hidden="true"></canvas>

  <section class="s hero">
    <DragoEave lanterns={[{ x: 12, side: 'l', y: 16, drop: 3, size: 21 }, { x: 88, side: 'r', y: 124, drop: 7, size: 15 }]} />
    <div class="hero__piece" data-page-hero>
      {artifact.image && <ArtifactPiece artifact={{ ...artifact, image: artifact.image }} />}
    </div>
  </section>

  <!-- The sign: neon on the dark awning, its white struts crossing behind -->
  <section class="s sign">
    <DragoEave />
    <div class="sign__panel">
    <i class="strut strut--a" aria-hidden="true"></i>
    <i class="strut strut--b" aria-hidden="true"></i>
    <h1 class="neon" aria-label={txt.title}>
      {
        txt.title.split(' ').map((word) => (
          <span class="neon__word" aria-hidden="true">
            {[...word].map((c, i) => (
              <span class:list={['neon__c', { 'neon__c--faulty': (word.length + i) % 9 === 4 }]} data-c={c}>
                {c}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
    {txt.subtitle && <p class="sign__sub">{txt.subtitle}</p>}
    <p class="sign__body">{txt.body}</p>
    </div>
  </section>

  <!-- The brown cabinet it was, wiped away into the piece as the slice crosses the screen -->
  <section class="s bay" data-pan>
    <DragoEave lanterns={[{ x: 92, side: 'l', y: 3, drop: 2, size: 13 }]} />
    <figure class="shop shop--square wipe">
      <span class="shop__transom" aria-hidden="true"></span>
      <div class="shop__glass">
        <img {...photo('before', 1800, 1800)} sizes="(orientation: portrait) 88vw, 60svh" alt={alt} loading="lazy" />
        <img class="wipe__after" {...photo('after', 1800, 1800)} sizes="(orientation: portrait) 88vw, 60svh" alt={alt} loading="lazy" />
        <i class="wipe__line" aria-hidden="true"></i>
      </div>
    </figure>
  </section>

  <section class="s bay">
    <DragoEave lanterns={[{ x: 4, side: 'l', y: 160, drop: 5, size: 17 }, { x: 62, side: 'r', y: 40, drop: 1, size: 12 }]} />
    <figure class="shop shop--square" data-lane="r">
      <span class="shop__transom" aria-hidden="true"></span>
      <div class="shop__glass">
        <video src={src('turn.mp4')} poster={src('turn.webp')} width="720" height="720" muted loop playsinline preload="none" data-play></video>
      </div>
    </figure>
    <figure class="shop shop--tall" data-lane="l">
      <span class="shop__transom" aria-hidden="true"></span>
      <div class="shop__glass">
        <img {...photo('wall-far', 1350, 1800)} sizes="(orientation: portrait) 91vw, 45svh" alt={alt} loading="lazy" />
      </div>
    </figure>
  </section>

  <!-- The frosted window, as on the moodboard: an arched heading in red vinyl -->
  {
    first && (
      <section class="s frost">
        <DragoEave />
        <div class="frost__glass">
          <h2 class="frost__head">
            <svg viewBox="0 0 400 118">
              <path id="frost-arc" d="M18 112 Q200 -28 382 112" fill="none" />
              <text text-anchor="middle" font-size={archSize(first.title)}>
                <textPath href="#frost-arc" startOffset="50%">{first.title}</textPath>
              </text>
            </svg>
          </h2>
          <p class="frost__body">{first.body}</p>
        </div>
      </section>
    )
  }

  <!-- The lazy Susan: the piece's details as dishes, turning with the scroll -->
  <section class="s susan" data-pan>
    <DragoEave lanterns={[{ x: 8, side: 'l', y: 3, drop: 9, size: 14 }, { x: 93, side: 'l', y: 150, drop: 4, size: 19 }]} />
    <div class="table" data-susan>
      <div class="turn" data-turn>
        {
          ring.map((name, i) => (
            <span class="dish" style={`--a: ${i * 60}deg`}>
              <img {...plateAt(name)} sizes="(orientation: portrait) 46vw, 20svh" alt="" loading="lazy" />
            </span>
          ))
        }
        <span class="dish dish--middle">
          <img {...plateAt('crest')} sizes="(orientation: portrait) 46vw, 20svh" alt={alt} loading="lazy" />
        </span>
      </div>
    </div>
  </section>

  <section class="s bay">
    <DragoEave lanterns={[{ x: 50, side: 'l', y: 40, drop: 1, size: 11 }]} />
    <figure class="shop shop--square" data-lane="l">
      <span class="shop__transom" aria-hidden="true"></span>
      <div class="shop__glass">
        <video src={src('door.mp4')} poster={src('door.webp')} width="720" height="720" muted loop playsinline preload="none" data-play></video>
      </div>
    </figure>
    <figure class="shop shop--square" data-lane="r">
      <span class="shop__transom" aria-hidden="true"></span>
      <div class="shop__glass">
        <img {...photo('wall-near', 1800, 1800)} sizes="(orientation: portrait) 91vw, 60svh" alt={alt} loading="lazy" />
      </div>
    </figure>
  </section>

  <!-- The walk backwards: pinned, three times as long as the screen, the piece staying put
       while the artist and the whole room come into view around it -->
  <section class="s pin" data-pan>
    <div class="pin__stage">
      <DragoEave lanterns={[{ x: 10, side: 'l', y: 14, drop: 6, size: 22 }, { x: 90, side: 'r', y: 14, drop: 2, size: 16 }]} />
      <div class="zoom">
        <div class="zoom__world">
          <img class="zoom__far" {...photo('zoom-3', 1350, 1800)} sizes="(orientation: portrait) 100vw, 66svh" alt={alt} loading="lazy" />
          <img class="zoom__mid" {...photo('zoom-2', 1350, 1800)} sizes="(orientation: portrait) 100vw, 66svh" alt="" loading="lazy" />
          <img class="zoom__near" {...photo('zoom-1', 1350, 1800)} sizes="(orientation: portrait) 100vw, 66svh" alt="" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- The menu: laminated, its dishes the piece's three paints -->
  {
    second && (
      <section class="s menu-slice" data-pan>
        <DragoEave lanterns={[{ x: 86, side: 'r', y: 3, drop: 3, size: 13 }]} />
        <div class="menu">
          <h2 class="menu__head">{second.title}</h2>
          <p class="menu__body">{second.body}</p>
          <div class="menu__dishes" aria-hidden="true">
            <img src={src('swatch-blue.webp')} width="222" height="245" alt="" loading="lazy" />
            <img src={src('swatch-orange.webp')} width="215" height="245" alt="" loading="lazy" />
            <img src={src('swatch-yellow.webp')} width="215" height="245" alt="" loading="lazy" />
          </div>
          <i class="menu__gloss" aria-hidden="true"></i>
        </div>
      </section>
    )
  }

  <!-- Last, on the wall inside: the artist's drawing in its gilt frame, and the artist -->
  <section class="s bay last">
    <DragoEave lanterns={[{ x: 30, side: 'l', y: 157, drop: 2, size: 12 }, { x: 72, side: 'r', y: 304, drop: 5, size: 18 }]} />
    <figure class="gilt">
      <img {...photo('drawing', 1800, 1800)} sizes="(orientation: portrait) 88vw, 56svh" alt={alt} loading="lazy" />
    </figure>
    <figure class="shop shop--tall" data-lane="l">
      <span class="shop__transom" aria-hidden="true"></span>
      <div class="shop__glass">
        <img {...photo('held', 1350, 1800)} sizes="(orientation: portrait) 91vw, 45svh" alt={alt} loading="lazy" />
      </div>
    </figure>
    <figure class="shop shop--tall" data-lane="r">
      <span class="shop__transom" aria-hidden="true"></span>
      <div class="shop__glass">
        <img {...photo('peek', 1350, 1800)} sizes="(orientation: portrait) 91vw, 45svh" alt={alt} loading="lazy" />
      </div>
    </figure>
  </section>

  <!-- And the real thing: the moodboard itself, the street all this was made from, through
       the page's whole height. The body ends where it starts. -->
  <section class="s street" data-body-end>
    <img {...photo('street', 927, 1600)} sizes="(orientation: portrait) 100vw, 58svh" alt={alt} loading="lazy" />
  </section>
</div>

<style>
  .drago {
    /* the piece's paints, and the street's: all sizes in --u, which follows the short side */
    --u: 1svh;
    --blue: #3d55e0;
    --orange: #ee4a1e;
    --yellow: #f2da5e;
    --vinyl: #b4150f;
    --night: #070a1f;
    --led: #39a0ff;

    display: flex;
    height: 100%;
    /* a stacking context of its own: the fixed body sits over this wall, under the slices,
       and the page's last card covers it */
    isolation: isolate;
    /* the lanterns' halos stay out of the scroll range */
    overflow: clip;
    color: #fff5e6;
    background:
      linear-gradient(rgb(255 240 220 / 0.3), transparent 3%) 0 100% / 100% calc(var(--u) * 14) no-repeat,
      linear-gradient(transparent, #05060f 92%) 0 100% / 100% calc(var(--u) * 14) no-repeat,
      repeating-linear-gradient(
          90deg,
          rgb(255 60 30 / 0.55) 0,
          rgb(255 60 30 / 0) calc(var(--u) * 28),
          rgb(50 130 255 / 0.42) calc(var(--u) * 55),
          rgb(50 130 255 / 0) calc(var(--u) * 82),
          rgb(255 60 30 / 0.55) calc(var(--u) * 110)
        )
        0 100% / 100% calc(var(--u) * 14) no-repeat,
      linear-gradient(#150611, #05060f) 0 100% / 100% calc(var(--u) * 14) no-repeat,
      repeating-linear-gradient(90deg, rgb(30 2 2 / 0.4) 0 2px, transparent 2px calc(var(--u) * 11)),
      linear-gradient(#d83a18, #971a10 42%, #3f0a0c 86%);
  }
  .body {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: drop-shadow(0 calc(var(--u) * 1.4) calc(var(--u) * 1.2) rgb(20 0 0 / 0.55));
  }
  .s {
    flex: 0 0 auto;
    position: relative;
    z-index: 1;
    height: 100%;
  }

  /* Hero: the piece hung on the boards, in the lanterns' light */
  .hero {
    width: 130svh;
    max-width: 100vw;
  }
  .hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 49%;
    width: calc(var(--u) * 120);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(circle closest-side, rgb(255 190 110 / 0.5), transparent);
  }
  .hero__piece {
    position: absolute;
    left: 50%;
    top: calc(var(--u) * 15);
    width: calc(var(--u) * 57);
    aspect-ratio: 1022 / 1200;
    translate: -50% 0;
    filter: drop-shadow(calc(var(--u) * 1) calc(var(--u) * 1.6) calc(var(--u) * 1.6) rgb(30 2 2 / 0.6));
    /* the run's card stamps the same name on itself on click, so it morphs into this */
    view-transition-name: artifact-hero;
  }
  /* The sign: neon under the night awning */
  .sign {
    width: clamp(340px, 62svh, 90vw);
  }
  .sign__panel {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-m);
    padding: calc(var(--u) * 16) var(--space-m) var(--space-m);
    text-align: center;
    overflow: hidden;
    container-type: inline-size;
    background: repeating-linear-gradient(82deg, rgb(255 255 255 / 0.035) 0 3svh, transparent 3svh 9svh), linear-gradient(#0b1030, var(--night));
  }
  .strut {
    position: absolute;
    width: 150%;
    height: max(3px, calc(var(--u) * 0.7));
    background: #e7e2d6;
    opacity: 0.22;
    transform-origin: 0 50%;
  }
  .strut--a {
    left: -6%;
    top: 22%;
    rotate: 18deg;
  }
  .strut--b {
    left: 40%;
    top: 16%;
    rotate: 46deg;
  }
  .neon {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.34em;
    font-family: var(--font-futura);
    font-weight: 500;
    font-size: clamp(2.2rem, 14.5cqi, 5.4rem);
    line-height: 1.12;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #fff2ec;
    text-shadow:
      0 0 0.05em #fff,
      0 0 0.14em #ff5a3a,
      0 0 0.34em #ff2a12,
      0 0 0.8em #ff2a12;
  }
  .neon__word {
    display: inline-flex;
  }
  .neon__c {
    position: relative;
    animation: neon-hum 6.7s steps(1) infinite;
  }
  .neon__c--faulty {
    animation: neon-fault 4.3s steps(1) infinite;
  }
  /* the second tube: a blue one round each letter */
  .neon__c::before {
    content: attr(data-c);
    position: absolute;
    inset: 0;
    z-index: -1;
    color: transparent;
    -webkit-text-stroke: 0.09em var(--led);
    text-shadow: none;
    filter: drop-shadow(0 0 0.1em var(--led));
    opacity: 0.8;
  }
  @keyframes neon-hum {
    0%,
    100% {
      opacity: 1;
    }
    47% {
      opacity: 0.88;
    }
    49% {
      opacity: 1;
    }
  }
  @keyframes neon-fault {
    0%,
    100% {
      opacity: 1;
    }
    8% {
      opacity: 0.18;
    }
    10% {
      opacity: 1;
    }
    12% {
      opacity: 0.25;
    }
    19% {
      opacity: 1;
    }
    71% {
      opacity: 0.3;
    }
    73% {
      opacity: 1;
    }
  }
  .sign__sub {
    position: relative;
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--yellow);
  }
  .sign__body {
    position: relative;
    max-width: 34ch;
    font-size: var(--step--1);
    line-height: 1.6;
    opacity: 0.88;
  }

  /* Bays of shop windows: lit from inside, framed in the boards' wood, a slatted transom
     above and a frosted band across the foot of the glass */
  .bay {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 5);
    padding: calc(var(--u) * 12) calc(var(--u) * 8) calc(var(--u) * 14);
  }
  .shop {
    position: relative;
    flex: none;
    margin: 0;
    border: calc(var(--u) * 0.8) solid #33090a;
    background: #33090a;
    box-shadow:
      0 0 calc(var(--u) * 5) rgb(255 225 170 / 0.32),
      calc(var(--u) * 0.8) calc(var(--u) * 1.2) 0 rgb(25 2 2 / 0.55);
  }
  .shop__transom {
    display: block;
    height: calc(var(--u) * 5);
    margin-bottom: calc(var(--u) * 0.8);
    background: repeating-linear-gradient(90deg, #33090a 0 calc(var(--u) * 0.7), transparent calc(var(--u) * 0.7) calc(var(--u) * 4.4)), linear-gradient(#ffe6ad, #f6ba6e);
  }
  .shop__glass {
    position: relative;
    overflow: hidden;
    background: #f3efe5;
  }
  .shop__glass img,
  .shop__glass video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shop__glass::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 11%;
    background:
      linear-gradient(transparent 22%, rgb(180 21 15 / 0.75) 22% 26%, transparent 26% 72%, rgb(180 21 15 / 0.75) 72% 76%, transparent 76%),
      rgb(246 242 232 / 0.72);
    backdrop-filter: blur(5px);
    pointer-events: none;
  }
  .shop--square .shop__glass {
    width: calc(var(--u) * 60);
    aspect-ratio: 1;
  }
  .shop--tall .shop__glass {
    height: calc(var(--u) * 60);
    aspect-ratio: 3 / 4;
  }

  /* --w: 0 still the brown cabinet as the slice comes in, 1 all painted just past the middle */
  .wipe {
    --w: clamp(0, (0.62 - var(--pan, -1)) / 0.8, 1);
  }
  .wipe img {
    position: absolute;
    inset: 0;
  }
  /* the cabinet stands right down to the frame: no band across its feet */
  .wipe .shop__glass::after {
    content: none;
  }
  .wipe__after {
    clip-path: inset(0 calc((1 - var(--w)) * 100%) 0 0);
  }
  .wipe__line {
    position: absolute;
    inset: 0 auto 0 calc(var(--w) * 100%);
    width: max(3px, calc(var(--u) * 0.5));
    translate: -50% 0;
    background: #eaf8ff;
    box-shadow: 0 0 calc(var(--u) * 1.5) var(--led), 0 0 calc(var(--u) * 4) var(--led);
    /* gone once the wipe has landed */
    opacity: calc((1 - var(--w)) * 20);
  }

  /* The frosted window */
  .frost {
    width: calc(var(--u) * 74);
    max-width: 92vw;
    display: flex;
    align-items: center;
    padding: calc(var(--u) * 12) calc(var(--u) * 5) calc(var(--u) * 14);
  }
  .frost__glass {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: calc(var(--u) * 4);
    padding: calc(var(--u) * 3) calc(var(--u) * 5) calc(var(--u) * 9);
    overflow: hidden;
    border: calc(var(--u) * 0.8) solid #33090a;
    background:
      linear-gradient(transparent calc(100% - var(--u) * 6), rgb(180 21 15 / 0.75) calc(100% - var(--u) * 6) calc(100% - var(--u) * 5.6), transparent calc(100% - var(--u) * 5.6) calc(100% - var(--u) * 2.6), rgb(180 21 15 / 0.75) calc(100% - var(--u) * 2.6) calc(100% - var(--u) * 2.2), transparent calc(100% - var(--u) * 2.2)),
      radial-gradient(circle at 50% 42%, #fffdf6, #e9e3d2);
    color: var(--vinyl);
    box-shadow: 0 0 calc(var(--u) * 6) rgb(255 225 170 / 0.4);
  }
  .frost__head {
    width: 100%;
  }
  .frost__head svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .frost__head text {
    font-family: var(--font-futura);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: currentColor;
  }
  .frost__body {
    max-width: 44ch;
    font-size: var(--step--1);
    line-height: 1.55;
    text-align: center;
  }

  /* The lazy Susan, seen from above: a lacquered table and a glass turntable on it. It lies
     over the eave's LED rope, so the slice is wide enough to keep it clear of the lanterns. */
  .susan {
    --d: calc(var(--u) * 90);
    width: calc(var(--u) * 134);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: calc(var(--u) * 6);
  }
  .table {
    position: relative;
    z-index: 5;
    flex: none;
    width: var(--d);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 34%, #a81612, #5a0808 70%, #2c0405);
    box-shadow:
      inset 0 0 0 calc(var(--u) * 0.7) #e0a93a,
      inset 0 0 0 calc(var(--u) * 1.4) #5a0808,
      inset 0 0 0 calc(var(--u) * 1.7) #e0a93a,
      0 calc(var(--u) * 2) calc(var(--u) * 4) rgb(10 0 0 / 0.6);
    /* dragging it turns it (drago.ts), instead of scrolling */
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .table:active {
    cursor: grabbing;
  }
  /* no long-press menu or image drag on the plates: the pointer stays on the table */
  .dish img {
    pointer-events: none;
  }
  .turn {
    position: absolute;
    inset: 5%;
    border-radius: 50%;
    background: linear-gradient(125deg, rgb(255 255 255 / 0.32), rgb(255 255 255 / 0.06) 38%, rgb(255 255 255 / 0.22) 56%, rgb(255 255 255 / 0.04));
    box-shadow: inset 0 0 0 max(1px, calc(var(--u) * 0.2)) rgb(255 255 255 / 0.55);
    --scroll-turn: 150deg;
    rotate: calc(var(--pan, 0) * var(--scroll-turn) + var(--spin, 0) * 1deg);
  }
  /* A dish: the picture in a white rim, its blue-and-gold band straight off the crockery */
  .dish {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--d) * 0.27);
    aspect-ratio: 1;
    padding: calc(var(--d) * 0.024);
    border-radius: 50%;
    background: repeating-conic-gradient(#1f3ab8 0 7deg, #f7f3e8 7deg 14deg);
    box-shadow:
      inset 0 0 0 calc(var(--d) * 0.006) #e0a93a,
