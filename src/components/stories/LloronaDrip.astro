---
// One drop weeping down LloronaStory's wall, on a path of its own: it wanders as it
// falls — veering, skidding sideways over a bump, swinging back — drawn as one smooth
// curve from a seeded random (the same on every build). Its pace never settles: faster
// where the path is steep, slower where it slants, with a restless random swell on top,
// and now and then it catches on the stone and crawls a stretch — slowed right down,
// never stopped — before letting go. (SMIL,
// so the whole path scales with the SVG.) A dark wet streak grows behind it, then
// dries, and the cycle rests before the next drop. Units are --drip-u (1svh unless the
// page sets it): the SVG is as many units tall as the drop runs. Each drop is drawn
// twice, one per orientation: on portrait the same run with a drop and streak PHONE×
// as big (`only` keeps just one of the two — e.g. extra drops for phones).
interface Props {
  /** where it starts, % of its slice */
  x: number;
  y: number;
  /** how far it runs, svh */
  len: number;
  /** when it first sets off, s */
  delay: number;
  seed: number;
  /** if set, the wander is squeezed to within this many units either side */
  sway?: number;
  /** how many times slower than the default the whole cycle runs */
  pace?: number;
  only?: 'landscape' | 'portrait';
}
const { x, y, len, delay, seed, sway, pace = 1, only } = Astro.props;
/** how many times bigger the drop and its streak are on portrait */
const PHONE = 2.2;

// mulberry32
let state = seed >>> 0;
const rand = (a: number, b: number): number => {
  state = (state + 0x6d2b79f5) >>> 0;
  let t = state;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return a + (((t ^ (t >>> 14)) >>> 0) / 4294967296) * (b - a);
};

// The path: short steps down, the sideways drift carried from step to step (so it
// curves rather than zig-zags), kicked now and then into a skid, and reined back in
// whenever it strays too far from where it started.
const points: Array<[number, number]> = [[0, 0]];
let [px, py, drift] = [0, 0, 0];
while (py < len) {
  drift = drift * 0.55 + rand(-0.9, 0.9);
  if (rand(0, 1) < 0.12) drift += rand(-2.4, 2.4);
  if (Math.abs(px) > 3) drift -= px * 0.3;
  const dy = Math.min(len - py, rand(0.5, 1.8));
  py += dy;
  px += drift * rand(0.25, 0.7);
  points.push([px, py]);
}
const reach = Math.max(...points.map(([a]) => Math.abs(a)));
if (sway && reach > sway) points.forEach((pt) => (pt[0] *= sway / reach));

// The pace, stretch by stretch: steepness sets the speed, a random swell carried over
// from the stretch before keeps changing it, and on some stretches the drop catches and
// crawls (a fraction of its speed, never nothing).
type Stretch = { length: number; time: number };
const stretches: Stretch[] = [];
let swell = 1;
points.slice(1).forEach(([x1, y1], i) => {
  const [x0, y0] = points[i];
  const length = Math.hypot(x1 - x0, y1 - y0);
  const steep = (y1 - y0) / length;
  swell = swell * 0.6 + rand(0.3, 1.8) * 0.4;
  const crawl = rand(0, 1) < 0.1 ? rand(0.15, 0.3) : 1;
  stretches.push({ length, time: length / ((0.8 + 3.6 * steep ** 3) * swell * crawl) });
});
const total = stretches.reduce((a, b) => a + b.time, 0);
const distance = stretches.reduce((a, b) => a + b.length, 0);
/** share of the cycle spent running; the rest it dries and rests */
const RUN = 0.6;
const cumulate = (list: number[], whole: number): number[] =>
  list.reduce<number[]>((acc, v) => [...acc, acc[acc.length - 1] + v / whole], [0]);
const at = [...cumulate(stretches.map((st) => st.time), total).map((v) => v * RUN), 1];
const along = [...cumulate(stretches.map((st) => st.length), distance).map((v) => Math.min(1, v)), 1];
const fmt = (list: number[]): string => list.map((v) => v.toFixed(4)).join(';');
const keyTimes = fmt(at);
const keyPoints = fmt(along);
const trail = fmt(along.map((v) => 1 - v));
const dur = `${((total / RUN) * pace).toFixed(2)}s`;
const begin = `${delay}s`;

// one smooth curve through the points (Catmull-Rom as cubic Béziers)
const p = (i: number): [number, number] => points[Math.max(0, Math.min(points.length - 1, i))];
const n = (v: number): string => v.toFixed(2);
const d =
  `M${n(0)} ${n(0)}` +
  points
    .slice(1)
    .map((_, k) => {
      const [p0, p1, p2, p3] = [p(k - 1), p(k), p(k + 1), p(k + 2)];
      const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
      const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
      return `C${n(c1[0])} ${n(c1[1])} ${n(c2[0])} ${n(c2[1])} ${n(p2[0])} ${n(p2[1])}`;
    })
    .join('');
// The tail: dashes of the path itself running just behind the head, each shorter and
// wider than the last — a taper that bends with every curve, swelling into the head
// (r 0.5) so the two read as one drop. [length, width], units.
const HEAD = 0.5;
const TAIL: Array<[number, number]> = [
  [1.5, 0.1],
  [1.2, 0.24],
  [0.95, 0.4],
  [0.7, 0.56],
  [0.45, 0.72],
  [0.22, 0.88],
];
const sizes = [
  { media: 'landscape', k: 1 },
  { media: 'portrait', k: PHONE },
]
  .filter(({ media }) => !only || only === media)
  .map(({ media, k }) => ({
    media,
    k,
    tails: TAIL.map(([length, width]) => {
      const t = (length * k) / distance;
      return { width: width * k, dash: `${t.toFixed(4)} 2`, offsets: fmt(along.map((v) => t - v)) };
    }),
  }));
const xs = points.map(([a]) => a);
const left = Math.min(...xs) - 1;
const width = Math.max(...xs) + 1 - left;
---

{
  sizes.map(({ media, k, tails }) => (
    <svg
      class={`drip drip--${media}`}
      viewBox={`${left.toFixed(2)} -0.5 ${width.toFixed(2)} ${len + 1}`}
      style={`left:${x}%;top:${y}%;margin-left:calc(${left.toFixed(2)} * var(--drip-u, 1svh));width:calc(${width.toFixed(2)} * var(--drip-u, 1svh));height:calc(${len + 1} * var(--drip-u, 1svh))`}
      aria-hidden="true">
      <path class="drip__trail" d={d} stroke-width={0.6 * k} pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1">
        <animate
          attributeName="stroke-dashoffset"
          values={trail}
          keyTimes={keyTimes}
          calcMode="linear"
          dur={dur}
          begin={begin}
          repeatCount="indefinite"
        />
        <animate attributeName="opacity" values="1;1;0;0" keyTimes={`0;${RUN};0.95;1`} dur={dur} begin={begin} repeatCount="indefinite" />
      </path>
      <g opacity="0">
        <!-- the drop: tail and head painted solid, faded as one, so it has no seams -->
        <g class="drip__body">
          {
            tails.map(({ width, dash, offsets }) => (
              <path d={d} pathLength="1" stroke-width={width} stroke-dasharray={dash} stroke-dashoffset="1">
                <animate
                  attributeName="stroke-dashoffset"
                  values={offsets}
                  keyTimes={keyTimes}
                  calcMode="linear"
                  dur={dur}
                  begin={begin}
                  repeatCount="indefinite"
                />
              </path>
            ))
          }
          <g>
            <circle r={HEAD * k} />
            <animateMotion
              path={d}
              rotate="auto"
              keyPoints={keyPoints}
              keyTimes={keyTimes}
              calcMode="linear"
              dur={dur}
              begin={begin}
              repeatCount="indefinite"
            />
          </g>
        </g>
        <!-- the glint on the head, turned along the path (rotate="auto"): upper-left once turned -->
        <g>
          <circle class="drip__shine" cx={-0.16 * k} cy={0.18 * k} r={0.13 * k} />
          <animateMotion
            path={d}
            rotate="auto"
            keyPoints={keyPoints}
            keyTimes={keyTimes}
            calcMode="linear"
            dur={dur}
            begin={begin}
            repeatCount="indefinite"
          />
        </g>
        <animate
          attributeName="opacity"
          values="0;1;1;0;0"
          keyTimes={`0;0.02;${RUN};${RUN + 0.04};1`}
          dur={dur}
          begin={begin}
          repeatCount="indefinite"
        />
      </g>
    </svg>
  ))
}

<style>
  .drip {
    position: absolute;
    /* (the global reset's max-width: 100% would squash it in a zero-width lane) */
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }
  .drip__trail {
    fill: none;
    stroke: rgb(40 22 12 / 0.45);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* see-through, tinted the desk's celadon (its parts solid, the group faded as one,
     so their overlaps don't darken) */
  .drip__body {
    fill: none;
    stroke: var(--celadon);
    stroke-linecap: round;
    opacity: 0.68;
  }
  .drip__body circle {
    fill: var(--celadon);
    stroke: none;
  }
  .drip__shine {
    fill: rgb(255 245 230 / 0.85);
  }
  @media (orientation: portrait) {
    .drip--landscape {
      display: none;
    }
  }
  @media not (orientation: portrait) {
    .drip--portrait {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .drip {
      display: none;
    }
  }
</style>
