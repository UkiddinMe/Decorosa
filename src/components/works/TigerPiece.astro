---
// The tiger chest as a live piece: the artwork plus the two mouth strips over it. Same
// artwork and the same seam mechanics as the showcase panel (tigerArt in panels.ts,
// ANIMATIONS.md) — only the drive differs. There the orbit opens the mouth; here it is
// `.is-live` (pieces.ts — hover, or a cycle on touch): the drawer rolls out and the whole
// piece shakes itself a few times.
// Fills its container's width; the container places it and decides how big it is — and
// says so (`drawn`), for the copies the artwork and its strips are picked from.
import { mouthVars, tigerArt } from '../../data/panels';
import { ratio, sized, sizesAttr, type Sizes } from '../../data/images';

interface Props {
  /** how wide the artwork is drawn */
  drawn: Sizes;
}
const { drawn } = Astro.props;
const { image, mouth } = tigerArt;
const ref = Math.max(image.w, image.h);
---

<span class="tiger" style={mouthVars(mouth)}>
  <img
    class="tiger__media"
    {...sized(image.src, image.w, image.h)}
    sizes={sizesAttr(drawn)}
    style={ratio(image)}
    alt=""
    loading="eager"
    decoding="async"
  />
  <img
    class="tiger__mouth tiger__mouth--shut"
    {...sized(mouth.shut.src, mouth.shut.w, mouth.shut.h, ref)}
    sizes={sizesAttr(drawn, mouth.shut.w / image.w)}
    style={ratio(mouth.shut)}
    alt=""
    loading="eager"
    decoding="async"
  />
  <img
    class="tiger__mouth tiger__mouth--open"
    {...sized(mouth.open.src, mouth.open.w, mouth.open.h, ref)}
    sizes={sizesAttr(drawn, mouth.open.w / image.w)}
    style={ratio(mouth.open)}
    alt=""
    loading="eager"
    decoding="async"
  />
</span>

<script>
  import '../../scripts/pieces.ts';
</script>

<style>
  /* Height comes from the artwork itself, which is also what the mouth strips measure
     their % against — exactly as in the showcase, where the card box *is* the artwork. */
  .tiger {
    display: block;
    position: relative;
    width: 100%;
  }
  .tiger__media {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The mouth: the same two strips of one column of the artwork as the showcase panel
     (panels.ts), meeting on a single moving seam — the open drawer stretches down from
     the jaw line while the shut face is squeezed against its own floor and pushed out of
     sight. `--mouth-open` flips 0 -> 1 while live and each strip's `scale` eases across it,
     matching the smoothstep showcase.ts applies to the orbit. */
  .tiger__mouth {
    position: absolute;
    left: var(--mouth-left);
    top: var(--mouth-top);
    width: var(--mouth-w);
    height: auto;
    transition: scale 0.55s cubic-bezier(0.45, 0, 0.55, 1);
  }
  .tiger__mouth--open {
    transform-origin: 50% 0;
    scale: 1 var(--mouth-open, 0);
  }
  /* The extra 0.006 is one hairline of overlap, hidden under the open strip: without it a
     rounding difference between the two scales can open a gap on the seam. */
  .tiger__mouth--shut {
    transform-origin: 50% 100%;
    scale: 1 clamp(0, calc(1.006 - var(--mouth-open, 0) * var(--mouth-squeeze)), 1);
  }

  /* The shake (`shake`, global.css): one shot per turn — each new turn plays it
     again. It pivots high in the box, as the showcase panel's glide does: a thing carried
     swings from above. */
  .tiger {
    transform-origin: 50% 25%;
  }
  .tiger.is-live {
    --mouth-open: 1;
    animation: shake 0.42s ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .tiger__mouth {
      transition: none;
    }
    .tiger.is-live {
      animation: none;
    }
  }
</style>
