---
// Artwork for the tiles end card: the "Dessert" painting with its cherry and the cherry's
// cast shadow lifted off (scripts/build-image-assets.py) — the plate is the card's
// `media`, this is only those two layers. The cherry drops onto the ridge, jiggles,
// rests, fades out in place and falls again; while it falls its shadow wipes in from the
// bottom of the dune up to the peak, and fades out with it — one looping CSS animation.
// The viewBox is the plate's own pixel grid (1024×1536, 2:3), so both layers sit exactly
// where they were cut from the painting.
import { withBase } from '../../data/routes';
---

<svg class="dune" viewBox="0 0 1024 1536" aria-hidden="true">
  <defs>
    <!-- three shadow heights tall: a dark top third (it sits over the shadow at rest, soft
         band included, so nothing shows before the wipe starts), a soft band a tenth of
         the shadow tall, then lit. Sliding it up 1.1 shadow heights uncovers all of it. -->
    <linearGradient id="dune-wipe-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0.3333" stop-color="#000" />
      <stop offset="0.3667" stop-color="#fff" />
    </linearGradient>
    <mask id="dune-wipe" maskUnits="userSpaceOnUse">
      <rect
        class="shadow-wipe"
        x="539.4"
        y="754.7"
        width="484.6"
        height="2345.1"
        fill="url(#dune-wipe-fill)"
      />
    </mask>
  </defs>
  <image
    class="shadow"
    href={withBase('/assets/works/dessert-shadow.webp')}
    x="539.4"
    y="754.7"
    width="484.6"
    height="781.7"
    mask="url(#dune-wipe)"
  />
  <image
    class="cherry"
    href={withBase('/assets/works/dessert-cherry.webp')}
    x="497.4"
    y="462.1"
    width="185.3"
    height="302.3"
  />
</svg>

<style>
  .dune {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cherry {
    /* squash pivots on the point that touches the sand (the image's bottom edge) */
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: cherry-drop 7.5s linear infinite;
  }

  .shadow {
    animation: shadow-fade 7.5s linear infinite;
  }
  .shadow-wipe {
    animation: shadow-wipe 7.5s linear infinite;
  }

  /* fall (gravity), land, jiggle out, rest, fade in place, then wait offstage for the next
     loop. Offsets are viewBox units: -800 clears the plate's top edge; the bounces are
     small hops, the squash does most of the jiggling. */
  @keyframes cherry-drop {
    0% {
      opacity: 1;
      transform: translateY(-800px);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5);
    }
    12% {
      transform: translateY(0) scale(1, 1);
      animation-timing-function: ease-out;
    }
    14% {
      transform: translateY(0) scale(1.16, 0.8);
    }
    18% {
      transform: translateY(-22px) scale(0.95, 1.06);
    }
    22% {
      transform: translateY(0) scale(1.09, 0.92);
    }
    25% {
      transform: translateY(-8px) scale(0.98, 1.02);
    }
    28% {
      transform: translateY(0) scale(1.04, 0.97);
    }
    32%,
    70% {
      opacity: 1;
      transform: translateY(0) scale(1, 1);
    }
    80% {
      opacity: 0;
      transform: translateY(0) scale(1, 1);
    }
    81%,
    100% {
      opacity: 0;
      transform: translateY(-800px);
    }
  }

  /* the shadow climbs from the dune's foot while the cherry is in the air, reaching the
     peak as it lands, and its tip draws back down the slope a little on each hop.
     -859.9 is 1.1 shadow heights (781.7): the mask's lit part fully over the shadow. */
  @keyframes shadow-wipe {
    0%,
    3% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5);
    }
    12%,
    14% {
      transform: translateY(-859.9px);
      animation-timing-function: ease-out;
    }
    18% {
      transform: translateY(-789.9px);
    }
    22% {
      transform: translateY(-859.9px);
    }
    25% {
      transform: translateY(-834.9px);
    }
    28%,
    80% {
      transform: translateY(-859.9px);
    }
    /* re-armed while the shadow is still fully faded, never on the loop's wrap */
    81%,
    100% {
      transform: translateY(0);
    }
  }
  /* fades out alongside the cherry; back to 1 on the wrap, by when the mask hides it */
  @keyframes shadow-fade {
    0%,
    70% {
      opacity: 1;
    }
    80%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cherry,
    .shadow,
    .shadow-wipe {
      animation: none;
    }
    .shadow-wipe {
      transform: translateY(-859.9px);
    }
  }
</style>
