---
// Flames licking off a piece's outline, for its motion tree (the `flames` node,
// src/data/motion.ts): drawn, not cut from the photo. Each flame is a curvy tongue with its
// tip curled to one side, a yellow core inside a gradient that runs from hot at the root to
// red at the tip. A turbulence displacement rags the edges; the noise stays put while the
// flames move through it, so the edges keep changing. Only the shapes are drawn here:
// every turn live, scripts/pieces.ts re-roots each flame somewhere new along its edge
// (`data-flames`), with its own height, curl, sway and pace; it then flares up and fades,
// swaying, along one smooth curve: out to the edge's `to`, slowing, while it rises ever
// faster — all inside 0.8s (ArtifactPiece.astro).
import type { Flames } from '../../data/motion';

interface Props {
  flames: Flames;
  /** the cut-out's width: its centre line is what "outwards" is measured from */
  w: number;
  /** per-instance prefix for the ids of the gradients and filter */
  uid: string;
}
const { flames, w, uid } = Astro.props;

/** the tongues are drawn this tall; pieces.ts scales each to its rolled height */
const H = 100;
/** a flame of height h pointing up from (0, 0): a round belly, an S-bend, a curled tip */
const tongue = (h: number) =>
  [
    'M 0 0',
    `C ${-0.34 * h} ${-0.02 * h} ${-0.4 * h} ${-0.32 * h} ${-0.17 * h} ${-0.52 * h}`,
    `C ${-0.04 * h} ${-0.64 * h} ${-0.2 * h} ${-0.82 * h} ${0.06 * h} ${-h}`,
    `C ${0.02 * h} ${-0.82 * h} ${0.26 * h} ${-0.7 * h} ${0.25 * h} ${-0.47 * h}`,
    `C ${0.32 * h} ${-0.28 * h} ${0.3 * h} ${-0.02 * h} 0 0 Z`,
  ].join(' ');

const edges = flames.edges.map(({ x, out }) =>
  JSON.stringify({ x, out, lean: (Math.sign(x - w / 2) || 1) * 18, height: flames.height, unit: H, min: flames.per[0] }),
);
---

<linearGradient id={`${uid}-flame-g`} x1="0" y1="1" x2="0" y2="0">
  <stop offset="0" stop-color="#ffd23f" />
  <stop offset="0.4" stop-color="#ff7a1a" />
  <stop offset="0.8" stop-color="#e3361b" />
  <stop offset="1" stop-color="#b3161a" stop-opacity="0.6" />
</linearGradient>
<linearGradient id={`${uid}-flame-core-g`} x1="0" y1="1" x2="0" y2="0">
  <stop offset="0" stop-color="#fffbe0" />
  <stop offset="0.6" stop-color="#ffe066" />
  <stop offset="1" stop-color="#ffb52e" stop-opacity="0.4" />
</linearGradient>
<filter id={`${uid}-flame-f`} filterUnits="userSpaceOnUse" x="-200" y="-300" width={w + 400} height="1800" color-interpolation-filters="sRGB">
  <feTurbulence type="fractalNoise" baseFrequency="0.03 0.05" numOctaves="2" seed="5" result="noise" />
  <feDisplacementMap in="SourceGraphic" in2="noise" scale="14" xChannelSelector="R" yChannelSelector="G" />
  <feGaussianBlur stdDeviation="0.8" />
</filter>

<g filter={`url(#${uid}-flame-f)`}>
  {
    edges.map((edge) => (
      <g data-flames={edge}>
        {Array.from({ length: flames.per[1] }, () => (
          <g>
            <g class="m-flame-out">
              <g class="m-flame-rise">
                <g class="m-flame">
                  <g>
                    <path d={tongue(H)} fill={`url(#${uid}-flame-g)`} />
                    <path d={tongue(H * 0.55)} fill={`url(#${uid}-flame-core-g)`} />
                  </g>
                </g>
              </g>
            </g>
          </g>
        ))}
      </g>
    ))
  }
</g>
