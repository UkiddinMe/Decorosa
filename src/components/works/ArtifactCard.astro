---
// One card of the "MY" run. The media element is what flies into the detail page:
// works.ts stamps `view-transition-name: artifact-hero` on it just before navigating.
import { artifactMedia, artifactPath, type Artifact } from '../../data/artifacts';
import { withBase } from '../../data/routes';

interface Props {
  artifact: Artifact;
  lang: 'it' | 'en';
}
const { artifact, lang } = Astro.props;
const txt = artifact.i18n[lang];
---

<a
  class="artifact-card"
  href={withBase(artifactPath(artifact.id, lang))}
  data-artifact={artifact.id}
  data-card
  style={`--media:${artifactMedia(artifact)}`}
>
  <span class="artifact-card__media" data-hero></span>
  <span class="artifact-card__title">{txt.title}</span>
</a>

<style>
  .artifact-card {
    flex: 0 0 auto;
    width: var(--artifact-w);
    text-decoration: none;
    color: var(--fg);
    display: grid;
    gap: 0.9rem;
    /* --near is written by works.ts (1 at viewport centre) */
    scale: calc(1 + 0.2 * var(--near, 0));
    transform-origin: 50% 50%;
    transition: scale 0.3s var(--ease-out);
  }
  .artifact-card__media {
    aspect-ratio: 2 / 3;
    border-radius: 0.4rem;
    background: var(--media, var(--c-grey));
    box-shadow: 0 16px 40px -12px rgb(0 0 0 / 0.28);
    /* the blur spreads in every direction, so it always haloes over the top edge (and
       the halo slides as the card scales). Clip the paint at that edge: the shadow only
       ever shows below and beside the card. */
    clip-path: inset(0 -80px -80px -80px);
  }
  .artifact-card__title {
    font-family: var(--font-futura);
    font-size: var(--step-0);
    letter-spacing: 0.04em;
    line-height: 1.2;
    /* a fixed two-line box, not a minimum: every card is exactly as tall as every other,
       so the plates line up and the centre swell (origin 50% 50%) keeps them lined up.
       A longer label wraps past the box and simply overflows, centred. */
    height: 2.4em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .artifact-card:hover .artifact-card__title {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .artifact-card {
      scale: 1;
    }
  }
</style>
