---
// One card of the "MY" run. The media element is what flies into the detail page:
// works.ts stamps `view-transition-name: artifact-hero` on it just before navigating.
// Every piece floats frameless in the card's box: its cut-out, or — the one flagged
// `tiger` — the live tiger chest.
import { artifactImage, artifactPath, type Artifact } from '../../data/artifacts';
import TigerPiece from './TigerPiece.astro';
import { withBase } from '../../data/routes';

interface Props {
  artifact: Artifact;
  lang: 'it' | 'en';
}
const { artifact, lang } = Astro.props;
const txt = artifact.i18n[lang];
---

<a
  class="artifact-card"
  href={withBase(artifactPath(artifact.id, lang))}
  data-artifact={artifact.id}
  data-card
  data-return
>
  <span class="artifact-card__media" data-hero>
    {
      artifact.tiger ? (
        <span class="artifact-card__tiger">
          <TigerPiece />
        </span>
      ) : (
        artifact.image && (
          <img
            class="artifact-card__art"
            src={withBase(artifactImage(artifact))}
            width={artifact.image.w}
            height={artifact.image.h}
            alt=""
            decoding="async"
          />
        )
      )
    }
  </span>
  <span class="artifact-card__title">{txt.title}</span>
</a>

<style>
  .artifact-card {
    flex: 0 0 auto;
    width: var(--artifact-w);
    text-decoration: none;
    color: var(--fg);
    display: grid;
    gap: 0.9rem;
    /* --near is written by works.ts (1 at viewport centre) */
    scale: calc(1 + 0.2 * var(--near, 0));
    transform-origin: 50% 50%;
    transition: scale 0.3s var(--ease-out);
  }
  /* The box holds the piece's place in the run — so every title hangs from the same line
     and the detail page has a box to morph from — but paints nothing of its own. */
  .artifact-card__media {
    position: relative;
    aspect-ratio: 2 / 3;
  }
  /* Standing on the box's floor. A little wider than the box, so a low wide piece (the
     table) is not dwarfed by the tall ones; the height still caps the tall ones. */
  .artifact-card__art {
    position: absolute;
    left: -15%;
    width: 130%;
    max-width: none;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    filter: drop-shadow(0 16px 22px rgb(0 0 0 / 0.25));
  }
  .artifact-card__title {
    font-family: var(--font-futura);
    font-size: var(--step-0);
    letter-spacing: 0.04em;
    line-height: 1.2;
    /* a fixed two-line box, not a minimum: every card is exactly as tall as every other,
       so the plates line up and the centre swell (origin 50% 50%) keeps them lined up.
       A longer label wraps past the box and simply overflows, centred. */
    height: 2.4em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .artifact-card:hover .artifact-card__title {
    color: var(--accent);
  }

  /* The tiger is wider than its box and its drawer hangs past the bottom edge; the
     overflow is still inside the link, so the whole tiger is clickable.
     Half again as wide as its box, and hanging a little below the centre of it — about as
     low as it can sit: at full stretch the drawer reaches past the bottom of the box, and
     what is left between there and the title is all the room it has. The title row itself
     can't move — every card in the run hangs its label from the same line. The width is
     what keeps the piece clear of the run's top edge, which clips: it has to have room to
     swing there without losing its corners. */
  .artifact-card__tiger {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 160%;
    translate: -50% -47%;
  }

  @media (prefers-reduced-motion: reduce) {
    .artifact-card {
      scale: 1;
    }
  }
</style>
